<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scorix_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scorix_widget_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/scorix_widget_clock"
            android:layout_width="140dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:maxLines="1"
            android:textColor="@color/scorix_widget_fg"
            android:textSize="56sp"
            android:textStyle="bold"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            tools:targetApi="o" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scorix_widget_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/scorix_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scorix_widget_title_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scorix_widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_fg"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scorix_widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
