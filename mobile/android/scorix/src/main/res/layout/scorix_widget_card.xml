<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scorix_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scorix_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/scorix_widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/scorix_widget_title"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_fg"
        android:textSize="40sp"
        android:textStyle="bold"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform"
        tools:targetApi="o" />

    <TextView
        android:id="@+id/scorix_widget_title_accent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_accent"
        android:textSize="40sp"
        android:textStyle="bold"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform"
        tools:targetApi="o" />

    <TextView
        android:id="@+id/scorix_widget_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_fg"
        android:textSize="13sp" />
</LinearLayout>
