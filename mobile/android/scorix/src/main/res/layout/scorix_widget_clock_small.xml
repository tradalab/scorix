<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scorix_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scorix_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextClock
        android:id="@+id/scorix_widget_clock"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:maxLines="1"
        android:textColor="@color/scorix_widget_fg"
        android:textSize="32sp"
        android:textStyle="bold"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeTextType="uniform"
        tools:targetApi="o" />

    <TextView
        android:id="@+id/scorix_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_fg"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scorix_widget_title_accent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/scorix_widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
