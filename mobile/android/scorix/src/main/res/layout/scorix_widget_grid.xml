<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scorix_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scorix_widget_bg"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/scorix_widget_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scorix_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_fg"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scorix_widget_title_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scorix_widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/scorix_widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/scorix_widget_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:contentDescription="@string/scorix_widget_back_desc"
            android:src="@drawable/scorix_widget_ic_today"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scorix_widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:contentDescription="@string/scorix_widget_prev_desc"
            android:text="@string/scorix_widget_prev"
            android:textColor="@color/scorix_widget_fg"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/scorix_widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:contentDescription="@string/scorix_widget_next_desc"
            android:text="@string/scorix_widget_next"
            android:textColor="@color/scorix_widget_fg"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scorix_widget_cells"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
